{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ${PLUGIN_ROOT}/scripts/session_start.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ${PLUGIN_ROOT}/scripts/user_prompt_submit.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ${PLUGIN_ROOT}/scripts/stop.py" }
        ]
      }
    ]
  }
}
