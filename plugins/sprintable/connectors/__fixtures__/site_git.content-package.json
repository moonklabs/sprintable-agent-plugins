{
  "connector_key": "site_git",
  "version": "1.0.0",
  "channel": "site_git",
  "kinds": [
    "publish"
  ],
  "fields": [
    {
      "name": "title",
      "type": "string",
      "source": "content",
      "required": true
    },
    {
      "name": "body",
      "type": "string",
      "source": "content",
      "required": true
    },
    {
      "name": "slug",
      "type": "string",
      "source": "content",
      "required": true
    },
    {
      "name": "lang",
      "type": "string",
      "source": "content",
      "required": true
    },
    {
      "name": "summary",
      "type": "string",
      "source": "content",
      "required": false
    },
    {
      "name": "tags",
      "type": "array",
      "source": "content",
      "required": false,
      "constraints": {
        "itemType": "string"
      }
    },
    {
      "name": "repo",
      "type": "string",
      "source": "org_config",
      "required": true,
      "setup_hint": "정적 사이트 GitHub 저장소 — \"owner/name\" 형태로 조직 설정 화면에 등록"
    },
    {
      "name": "branch",
      "type": "string",
      "source": "org_config",
      "required": true,
      "setup_hint": "커밋 대상 브랜치(보통 배포 트리거 브랜치, 예: main) — 조직 설정 화면에 등록"
    },
    {
      "name": "path_template",
      "type": "string",
      "source": "org_config",
      "required": true,
      "setup_hint": "저장소 안 파일 경로 규칙 — 조직 설정 화면에 등록(기본값 없음, 명시 필수)"
    },
    {
      "name": "site_base_url",
      "type": "string",
      "source": "org_config",
      "required": true,
      "setup_hint": "공개 사이트 주소(예: https://sprintable.ai) — 조직 설정 화면에 등록"
    }
  ],
  "requires_env": [
    "SITE_GIT_GITHUB_TOKEN"
  ]
}
